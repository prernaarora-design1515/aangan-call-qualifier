# --- Database (Neon) ---
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# --- Vaani AI (app.vaanivoice.ai: voice + telephony) ---
VAANI_WEBHOOK_SECRET=make-up-a-long-random-string   # appended to the webhook URL as ?key=
VAANI_API_KEY=                                      # needed for Call a lead + /api/vaani/sync (Developers > API Key)
VAANI_AGENT_ID=                                     # agent UUID (Agents list) — used by Call a lead
VAANI_OUTBOUND_NUMBER=                              # optional caller ID for outbound calls (E.164)
OUTBOUND_HOURLY_LIMIT=10                            # max dashboard-placed calls per hour
TOOL_SECRET=change-me-long-random        # shared secret the agent's HTTP tools send as x-tool-secret

# --- Gemini Flash (classification) ---
GEMINI_API_KEY=xxx
GEMINI_MODEL=gemini-3.8-flash                # 2.5 Flash is retired

# --- HubSpot (CRM) ---
HUBSPOT_TOKEN=pat-na1-xxx                # Private app: crm.objects.contacts/deals write + read

# --- Resend (designer handoff email) ---
RESEND_API_KEY=re_xxx
EMAIL_FROM="Aangan Call Desk <calls@yourdomain.in>"   # domain must be verified in Resend
DESIGNER_EMAILS=design@aanganstudio.in   # comma-separated
FOUNDER_EMAIL=nikhil@aanganstudio.in     # escalations (existing-client complaints)

# --- Cal.com (consultation booking during the call) ---
CALCOM_API_KEY=cal_live_xxx
CALCOM_EVENT_TYPE_ID=123456
CALCOM_FALLBACK_EMAIL=hello@aanganstudio.in  # used when a caller has no email to give

# --- Dashboard ---
DASHBOARD_PASSWORD=change-me             # basic auth (any username)
SKIP_DEMO=                               # set to 1 to leave out the October demo calls

# --- Cost model (₹) — tune to your actual plans ---
USD_INR=88
GEMINI_INPUT_USD_PER_M=0.30
GEMINI_OUTPUT_USD_PER_M=2.50
VAANI_INR_PER_MIN=5.6                    # from the Vaani agent page
RESEND_INR_PER_EMAIL=0
FIXED_MONTHLY_INR=0                      # e.g. phone number rental
